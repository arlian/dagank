{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kasir-umkm",
  "compatibility_date": "2026-08-31",

  // Static assets only, no Worker script. Nothing in this app runs on a
  // server, and nothing ever should: `src/data/` may not await the network.
  "assets": {
    "directory": "./dist",

    // Hash routing means every real URL is `/`, so there are no deep paths to
    // rewrite and a fallback would buy nothing. What it would cost is real: a
    // missing asset would come back as 200 + index.html, which the browser
    // reports as a MIME type error naming no file. Let a 404 be a 404.
    "not_found_handling": "none"
  }
}
